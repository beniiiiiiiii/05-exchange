<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Solution.DesktopApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Solution.DesktopApp.Pages"
    Title="Exchange Management">

    <TabBar>
        <ShellContent 
            Title="Dashboard" 
            Icon="chart_icon.png"
            ContentTemplate="{DataTemplate local:DashboardPage}"
            Route="dashboard" />

        <ShellContent 
            Title="Transactions" 
            Icon="transaction_icon.png"
            ContentTemplate="{DataTemplate local:TransactionsPage}"
            Route="transactions" />

        <ShellContent 
            Title="Rates" 
            Icon="rates_icon.png"
            ContentTemplate="{DataTemplate local:ExchangeRatesPage}"
            Route="exchangerates" />
    </TabBar>

</Shell>
